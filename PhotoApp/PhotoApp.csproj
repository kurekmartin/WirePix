<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net10.0-windows10.0.17763.0</TargetFramework>
        <UseWPF>true</UseWPF>
        <UseWindowsForms>true</UseWindowsForms>
        <RootNamespace>PhotoApp</RootNamespace>
        <AssemblyName>WirePix</AssemblyName>
        <ApplicationIcon>icon.ico</ApplicationIcon>
        <IncludeMaterialDesignFont>true</IncludeMaterialDesignFont>
        <MaterialDesignFontDirectory>Resources\Roboto\</MaterialDesignFontDirectory>
        <Platforms>x64</Platforms>
        <PlatformTarget>x64</PlatformTarget>
        <Prefer32Bit>false</Prefer32Bit>
        <Nullable>disable</Nullable>
        <ImplicitUsings>disable</ImplicitUsings>
        <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
        <AssetTargetFallback>$(AssetTargetFallback);net48</AssetTargetFallback>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="MaterialDesignColors" Version="2.0.5"/>
        <PackageReference Include="MaterialDesignThemes" Version="4.4.0"/>
        <PackageReference Include="Octokit" Version="0.50.0"/>
    </ItemGroup>

    <ItemGroup>
        <EmbeddedResource Update="Properties\Keys.resx">
            <Generator>ResXFileCodeGenerator</Generator>
            <LastGenOutput>Keys.Designer.cs</LastGenOutput>
        </EmbeddedResource>
        <EmbeddedResource Update="Properties\Languages.resx">
            <Generator>PublicResXFileCodeGenerator</Generator>
            <LastGenOutput>Languages.Designer.cs</LastGenOutput>
        </EmbeddedResource>
        <EmbeddedResource Update="Properties\Resources.cs.resx">
            <Generator>PublicResXFileCodeGenerator</Generator>
            <LastGenOutput>Resources.cs.Designer.cs</LastGenOutput>
        </EmbeddedResource>
        <EmbeddedResource Update="Properties\Resources.en.resx">
            <Generator>PublicResXFileCodeGenerator</Generator>
            <LastGenOutput>Resources.en.Designer.cs</LastGenOutput>
        </EmbeddedResource>
        <EmbeddedResource Update="Properties\Resources.resx">
            <Generator>PublicResXFileCodeGenerator</Generator>
            <LastGenOutput>Resources.Designer.cs</LastGenOutput>
        </EmbeddedResource>
        <EmbeddedResource Update="Properties\TagCodes.resx">
            <Generator>PublicResXFileCodeGenerator</Generator>
            <LastGenOutput>TagCodes.Designer.cs</LastGenOutput>
        </EmbeddedResource>
        <EmbeddedResource Update="Properties\TagGroups.resx">
            <Generator>ResXFileCodeGenerator</Generator>
            <LastGenOutput>TagGroups.Designer.cs</LastGenOutput>
        </EmbeddedResource>
        <None Update="Properties\Settings.settings">
            <Generator>SettingsSingleFileGenerator</Generator>
            <LastGenOutput>Settings.Designer.cs</LastGenOutput>
        </None>
    </ItemGroup>

    <ItemGroup>
        <Resource Include="MediaDevicesLicense.txt"/>
        <Resource Include="icon.ico"/>
    </ItemGroup>
    <ItemGroup>
        <ProjectReference Include="..\WirePix.Core\WirePix.Core.csproj"/>
        <ProjectReference Include="..\src\WirePix.Devices\WirePix.Devices.csproj" />
        <ProjectReference Include="..\src\WirePix.Devices.Windows\WirePix.Devices.Windows.csproj" />
        <Compile Remove="Models\*.cs"/>
    </ItemGroup>
</Project>
